# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goki?schema=public"

# Redis connection for BullMQ async timers (2h gathering, 24h dungeons, 7d raids)
REDIS_URL="redis://localhost:6379"

# API Server
PORT=4000
NODE_ENV="development"
JWT_SECRET="goki_jwt_super_secret_dev_secret_key_2026"

# Optional developer alert webhook (Discord or Slack webhook URL) for real-time crash/bug alerts
DIAGNOSTICS_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN"

# Application Auto-Update & Binary Manifest
APP_LATEST_VERSION="0.1.0"
APP_MIN_REQUIRED_VERSION="0.1.0"
ANDROID_APK_DOWNLOAD_URL="https://expo.dev/accounts/crimsondc143c/projects/goki/builds"
APP_RELEASE_NOTES="Performance improvements, bug fixes, and new RPG content."
