{
  "name": "@gymify/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Expo React Native + Expo Web RPG client & 2D Auto-Battler replay viewer",
  "main": "index.js",
  "scripts": {
    "eas-build-pre-build": "cd ../../ && npm run build --workspace=@gymify/game-engine",
    "start": "expo start --lan",
    "tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "*",
    "@gymify/game-engine": "*",
    "expo": "~58.0.22",
    "expo-audio": "~58.0.11",
    "expo-build-properties": "^58.0.12",
    "expo-constants": "*",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-image": "^58.0.18",
    "expo-notifications": "~58.1.7",
    "expo-secure-store": "^58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
