{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://goki-server.onrender.com"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://goki-server.onrender.com"
      },
      "ios": {
        "simulator": false
      }
    },
    "testflight": {
      "extends": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6832701462"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6832701462"
      }
    }
  }
}
