{
  "expo": {
    "name": "Gymify RPG",
    "slug": "gymify-rpg",
    "version": "0.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/18696d92-3fb6-4aa5-b4c3-e89952db9031",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "backgroundColor": "#0B0E14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gymify.rpg",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Gymify RPG requires access to your biometric Heart Rate telemetry to cryptographically verify workout effort and unlock Ironman Mode rewards.",
        "NSHealthUpdateUsageDescription": "Gymify RPG writes verified workout sessions and biometric telemetry to Apple Health."
      }
    },
    "android": {
      "package": "com.gymify.rpg",
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.BODY_SENSORS",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "backgroundColor": "#0B0E14"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#26A69A"
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableProguardInReleaseBuilds": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "18696d92-3fb6-4aa5-b4c3-e89952db9031"
      }
    }
  }
}
