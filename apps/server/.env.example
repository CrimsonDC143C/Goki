# Fastify Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*
JWT_SECRET=gymify_jwt_super_secret_dev_secret_key_2026

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymify_rpg?schema=public"

# Redis (BullMQ Timers & Workers)
REDIS_URL="redis://localhost:6379"

# Developer Diagnostics & Crash Alerts (Discord or Slack Incoming Webhook)
DIAGNOSTICS_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN"
# Optional comma-separated list of developer/admin emails allowed to access GET/PATCH /api/diagnostics/reports in production
ADMIN_EMAILS=""

# Application Auto-Update & Binary Manifest
APP_LATEST_VERSION="0.2.0"
APP_MIN_REQUIRED_VERSION="0.1.0"
ANDROID_APK_DOWNLOAD_URL="https://expo.dev/accounts/crimsondc143c/projects/gymify-rpg/builds"
APP_RELEASE_NOTES="Performance improvements, bug fixes, and new RPG content."
