{
  "name": "goki",
  "version": "0.1.0",
  "private": true,
  "description": "Goki: Fitness RPG — Cross-platform multiplayer gamified fitness tracker monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@goki/game-engine && npm run build --workspace=@goki/database && npm run build --workspace=@goki/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=@goki/game-engine && npm run test --workspace=@goki/server",
    "test:e2e": "playwright test",
    "db:validate": "npm run db:validate --workspace=@goki/database",
    "db:generate": "npm run db:generate --workspace=@goki/database",
    "db:push": "npm run db:push --workspace=@goki/database",
    "db:seed": "npm run db:seed --workspace=@goki/database",
    "dev:server": "npm run dev --workspace=@goki/server",
    "dev:mobile": "npm run start --workspace=@goki/mobile",
    "dev:web": "npm run web --workspace=@goki/mobile"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.14.0"
  }
}
